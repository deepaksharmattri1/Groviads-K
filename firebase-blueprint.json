{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated GROVIADS client or executive user profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User full display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email address.",
          "minLength": 3,
          "maxLength": 180
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL.",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["client", "admin"],
          "description": "Account access role."
        },
        "hasBookedConsultation": {
          "type": "boolean",
          "description": "Whether the user has booked their complimentary consultation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "role", "hasBookedConsultation", "createdAt", "updatedAt"]
    },
    "ClientLead": {
      "title": "ClientLead",
      "description": "Authenticated project inquiry synced to Firestore.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "serviceInterest": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "challenges": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "proposal_sent", "won", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "name", "email", "country", "phone", "serviceInterest", "challenges", "status", "createdAt", "updatedAt"]
    },
    "ClientAppointment": {
      "title": "ClientAppointment",
      "description": "Scheduled strategy consultation synced to Firestore.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "serviceInterest": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "appointmentDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "appointmentTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "timezone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "name", "email", "phone", "country", "serviceInterest", "appointmentDate", "appointmentTime", "timezone", "status", "createdAt", "updatedAt"]
    },
    "AdvisoryBrief": {
      "title": "AdvisoryBrief",
      "description": "Saved Search-grounded, Maps-grounded, or multi-turn advisory research brief.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "mode": {
          "type": "string",
          "enum": ["chat", "search_grounding", "maps_grounding"]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "responseText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "sources": {
          "type": "array",
          "description": "Bounded list of up to 10 verified source URLs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "title", "mode", "prompt", "responseText", "sources", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account documents keyed by Firebase Auth UID."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/ClientLead" },
      "description": "Authenticated client project inquiries."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/ClientAppointment" },
      "description": "Authenticated consultation bookings."
    },
    "/advisoryBriefs/{briefId}": {
      "schema": { "$ref": "#/entities/AdvisoryBrief" },
      "description": "Saved Gemini grounded research and advisory briefs."
    }
  }
}
